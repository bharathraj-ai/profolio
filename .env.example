# ==============================================================================
# Portfolio Environment Configuration
# ==============================================================================

# --- DATABASE CONFIGURATION ---
# Option 1: Neon Cloud PostgreSQL (Paste the connection string from your Neon dashboard)
# Example:
# DATABASE_URL=postgresql://neondb_owner:npg_your_password@ep-cool-fog-1234.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# Option 2: Individual JDBC parameters for Neon or any PostgreSQL:
# SPRING_DATASOURCE_URL=jdbc:postgresql://ep-cool-fog-1234.us-east-2.aws.neon.tech/neondb?sslmode=require
# SPRING_DATASOURCE_USERNAME=neondb_owner
# SPRING_DATASOURCE_PASSWORD=your_password
#
# Option 3: Local Docker PostgreSQL (Used by default if above are commented out):
# DB_URL=jdbc:postgresql://localhost:5432/portfolio
# DB_USER=portfolio
# DB_PASSWORD=change_me_locally

# --- ADMIN SETUP SECRET ---
ADMIN_SETUP_SECRET=dev_setup_secret_change_me

# --- BACKEND SERVER PORT ---
PORT=8080

# --- CORS SETTINGS ---
# Wildcards https://*.vercel.app and http://localhost:* are allowed by default.
# You can add explicit custom domains here:
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-domain.com

# --- FRONTEND VITE CONFIGURATION (Set in Vercel project environment variables) ---
# VITE_API_BASE_URL=https://your-backend-api.onrender.com

